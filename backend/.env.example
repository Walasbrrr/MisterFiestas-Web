# ============================================================
#  Variables de entorno del Backend — Mister Fiestas
# ============================================================
#  Copia este archivo como .env y completa los valores.
#  NUNCA subas el archivo .env a Git.
# ============================================================

# --- Base de Datos (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/mister_fiestas
DB_USER=mister_fiestas
DB_PASSWORD=change-me

# --- Instagram Graph API ---
# Para obtener estos valores necesitas:
# 1. Cuenta de Instagram Business/Creator
# 2. Meta App en https://developers.facebook.com
# 3. Generar un Long-Lived Access Token (60 días)
#
# Guía rápida:
# - Ve a https://developers.facebook.com/tools/explorer/
# - Selecciona tu app y genera un User Token con permiso instagram_basic
# - Intercámbialo por un Long-Lived Token (60 días)
# - El token se renueva automáticamente el día 1 de cada mes
INSTAGRAM_USER_ID=tu-instagram-user-id-aqui
INSTAGRAM_ACCESS_TOKEN=tu-long-lived-token-aqui

# --- Versión de la API de Instagram (opcional) ---
INSTAGRAM_API_VERSION=v21.0

# --- CORS (orígenes permitidos, separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Perfil de Spring (dejar "dev" para desarrollo local) ---
SPRING_PROFILES_ACTIVE=dev
